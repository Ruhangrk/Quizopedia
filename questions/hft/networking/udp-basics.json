      "id": "q1",
      "type": "mcq",
      "prompt": "Why is UDP often used for market data fanout?",
      "options": [
        {
          "id": "overhead",
          "text": "Lower overhead for one-way many-receiver delivery"
        },
        {
          "id": "retry",
          "text": "It always retries lost packets"
        },
        {
          "id": "order",
          "text": "It guarantees global ordering"
        },
        {
          "id": "tls",
          "text": "It always encrypts by default"
        }
      ],
      "correctOptionIds": [
        "overhead"
      ]
    },
    {
