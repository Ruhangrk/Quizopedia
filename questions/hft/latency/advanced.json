  "questions": [
    {
      "id": "q1",
      "type": "mcq",
      "prompt": "Which metric best captures rare but severe latency spikes?",
      "options": [
        {
          "id": "p50",
          "text": "p50 / median"
        },
        {
          "id": "p99",
          "text": "p99 / high percentile"
        },
        {
          "id": "mean",
          "text": "Arithmetic mean only"
        },
        {
          "id": "min",
          "text": "Minimum latency"
        }
      ],
      "correctOptionIds": [
        "p99"
      ],
      "explanation": "Tail percentiles expose spikes that averages hide."
    },
    {
      "id": "q2",
      "type": "mcq",
      "prompt": "Busy-polling a NIC typically trades ____ for lower latency.",
